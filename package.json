{
  "name": "memory-garden",
  "version": "1.0.0",
  "description": "An interactive, gamified data visualization tool for open data APIs.",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ui": "playwright test",
    "test:perf": "artillery run tests/performance/load.yml",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"tests/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\" \"tests/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\" \"tests/**/*.{js,jsx,ts,tsx}\"",
    "docs": "jsdoc -c jsdoc.conf.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.20.0",
    "@geckos.io/server": "^3.0.2",
    "@geckos.io/common": "^3.0.2",
    "talon": "*"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "@playwright/test": "^1.37.0",
    "artillery": "^2.0.0-31",
    "allure-commandline": "^2.23.0",
    "allure-jest": "^2.8.2",
    "eslint": "^8.46.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.0",
    "prettier": "^3.0.1",
    "jsdoc": "^4.0.2",
    "supertest": "^6.3.3"
  }
}